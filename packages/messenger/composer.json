{
  "name": "mmhospedagem/mvo-messenger-php",
  "description": "Cliente experimental PHP para o protocolo Web do Facebook Messenger, separado do SDK WhatsApp.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "php-64bit": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-sodium": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {"psr-4": {"MVO\\Messenger\\": "src/"}},
  "scripts": {
    "test": "@php vendor/bin/phpunit --configuration phpunit.xml",
    "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "check": ["@test", "@analyse"]
  },
  "homepage": "https://github.com/mmhospedagem/mvo-messenger-php",
  "keywords": ["php", "facebook", "messenger", "mvo", "persistent-session", "experimental"],
  "authors": [{"name": "MVO", "homepage": "https://www.mvo.host/"}],
  "support": {
    "issues": "https://github.com/mmhospedagem/mvo-messenger-php/issues",
    "source": "https://github.com/mmhospedagem/mvo-messenger-php",
    "docs": "https://mmhospedagem.github.io/mvo-whats-php/facebook/"
  },
  "archive": {
    "exclude": [
      "/vendor", "/composer.lock", "/.cache", "/.phpunit.cache", "/.phpunit.result.cache",
      "/.auth", "/.auth-backups", "/.env", "/.env.*", "/storage", "/var", "/sessions",
      "/secrets", "/captures", "/build", "*.sqlite", "*.sqlite-wal", "*.sqlite-shm",
      "*.log", "*.har", "*.pcap", "*.pcapng", "*.trace"
    ]
  }
}
